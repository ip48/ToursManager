# Environment Variables for Development
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/toursmanager
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# JWT Secret (at least 32 characters for HS256)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=dev_change_this_to_random_secret_minimum_32_characters

# Active Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# CORS Configuration
# Development: Leave empty (uses localhost by default)
# Production: Set to your domain(s), comma-separated
# Example: ALLOWED_ORIGINS=https://toursmanager.com,https://www.toursmanager.com
ALLOWED_ORIGINS=
